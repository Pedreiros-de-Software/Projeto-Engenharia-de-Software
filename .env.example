# Copie para .env (ignorado pelo git) antes de usar o docker compose: cp .env.example .env
# Credenciais do Postgres local de desenvolvimento e demonstração. Use só letras e números na senha;
# se mudar as credenciais depois da primeira subida, recrie o banco com: docker compose down -v
POSTGRES_USER=consensu
POSTGRES_PASSWORD=consensu
POSTGRES_DB=consensu

# Portas do host (opcional; padrões entre parênteses)
# WEB_PORT=3000
# API_PORT=8080
# POSTGRES_PORT=5432
